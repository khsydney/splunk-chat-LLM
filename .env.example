# ---------- existing app ----------
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
TEMPERATURE=0.2
EMBEDDING_MODEL=BAAI/bge-m3
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=rag_chunks
RETRIEVAL_TOP_K=100
RERANK_TOP_K=70
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry (opentelemetry-instrument → local collector → Splunk Observability Cloud)
OTEL_SERVICE_NAME=splunk-chat-llm
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# both judges need prompts/completions ON the LLM spans:
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# ---------- Jev vs Luna-2 demo ----------
# TypeSafe AI (Jev). Guard/evals are skipped when this is empty (or set MOCK_JEV=1 for offline plumbing tests)
TYPESAFE_API_KEY=
MOCK_JEV=0
JEV_MODEL=jev-1.13.0
JEV_GUARD_ENABLED=1
JEV_EVAL_MODE=sync           # sync | off
JEV_POST_BLOCK=0             # 1 = append a verification note to low-faithfulness answers
JEV_EVAL_TOP_DOCS=10         # reranked passages sent to Jev as context
JEV_CONTEXT_MAX_CHARS=40000
# thresholds — fit these on labelled turns before quoting numbers
JEV_BLOCK_THRESHOLD=0.70
JEV_REVIEW_THRESHOLD=0.35
JEV_SEVERITY_BLOCK=2.0
JEV_FAITHFUL_MIN=0.80
JEV_PII_FLAG=0.50
# describe YOUR documents (used by the off-topic check)
KB_TOPICS=vendor technical proposals for SPF (Cisco Sanwat, Splunk AppDynamics, WatchDog Purplex), the Monopoly rules, and Korean AI-industry reports

# Langfuse (Hobby tier is free). Export is off when empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_BLOCKED_SCOPES=opentelemetry.instrumentation.redis,opentelemetry.instrumentation.httpx

# Splunk Agent Observability (formerly Galileo). Export is off when empty. Set ONE deployment type:
SPLUNK_AO_PROJECT=jev-vs-luna
SPLUNK_AO_AGENT_STREAM=splunk-chat-llm
#   on-prem / standalone Enterprise tenant (full Luna-2 catalogue):
SPLUNK_AO_API_KEY=
SPLUNK_AO_CONSOLE_URL=
#   — or — Splunk Observability Cloud SaaS (4 Luna evaluators only):
# SPLUNK_AO_REALM=us1
# SPLUNK_AO_O11Y_TOKEN=
# SPLUNK_AO_O11Y_API_TOKEN=

# Agent Control (optional runtime guardrail on the Splunk side; needs agent-control-sdk, Python 3.12+)
AGENT_CONTROL_ENABLED=0
# AGENT_CONTROL_URL=
